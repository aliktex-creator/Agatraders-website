{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/disclosure/**",
              "components/editorial/**",
              "components/forms/**",
              "components/icon/**",
              "components/media/**",
              "components/navigation/**",
              "components/product/**",
              "ui_kits/retail/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Archivo Black))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Archivo Black."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:promo|ink|success)$/]",
        "message": "<Badge> tone must be one of 'promo' | 'ink' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|fullWidth|disabled|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, fullWidth, disabled, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|on-image|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'on-image' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|eyebrow|cta|onCta|image|imageNote|ratio|headlineColor|align|scale|key|ref|className|style|children)$/]",
        "message": "<CampaignTile> doesn't accept that prop. Declared props: headline, eyebrow, cta, onCta, image, imageNote, ratio, headlineColor, align, scale."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignTile'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:bottom-left|top-left)$/]",
        "message": "<CampaignTile> align must be one of 'bottom-left' | 'top-left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryIconCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|image|key|ref|className|style|children)$/]",
        "message": "<CategoryIconCard> doesn't accept that prop. Declared props: label, icon, image."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|defaultOpen|children|key|ref|className|style|children)$/]",
        "message": "<DisclosureRow> doesn't accept that prop. Declared props: label, size, defaultOpen, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureRow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:body|heading)$/]",
        "message": "<DisclosureRow> size must be one of 'body' | 'heading'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|count|children|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: active, count, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|options|key|ref|className|style|children)$/]",
        "message": "<FilterGroup> doesn't accept that prop. Declared props: title, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|tone|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:soft|bare|solid|on-image)$/]",
        "message": "<IconButton> tone must be one of 'soft' | 'bare' | 'solid' | 'on-image'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MemberBenefitCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|cta|onCta|image|imageNote|ratio|key|ref|className|style|children)$/]",
        "message": "<MemberBenefitCard> doesn't accept that prop. Declared props: title, body, cta, onCta, image, imageNote, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|stage|note|objectFit|style|children|key|ref|className|style|children)$/]",
        "message": "<Photo> doesn't accept that prop. Declared props: src, alt, ratio, stage, note, objectFit, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute[name.name='objectFit'] > Literal[value!=/^(?:cover|contain)$/]",
        "message": "<Photo> objectFit must be one of 'cover' | 'contain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|compareAt|percentOff|size|key|ref|className|style|children)$/]",
        "message": "<PriceRow> doesn't accept that prop. Declared props: price, compareAt, percentOff, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceRow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<PriceRow> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrimaryNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|logo|brand|bagCount|key|ref|className|style|children)$/]",
        "message": "<PrimaryNav> doesn't accept that prop. Declared props: items, active, onSelect, logo, brand, bagCount."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|category|price|compareAt|percentOff|image|imageNote|ratio|badge|colors|colorCount|activeColor|onSelectColor|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, category, price, compareAt, percentOff, image, imageNote, ratio, badge, colors, colorCount, activeColor, onSelectColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|width|key|ref|className|style|children)$/]",
        "message": "<SearchPill> doesn't accept that prop. Declared props: placeholder, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:breadcrumb|count|filtersOpen|onToggleFilters|sort|onSort|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: breadcrumb, count, filtersOpen, onToggleFilters, sort, onSort."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|active|label|size|key|ref|className|style|children)$/]",
        "message": "<SwatchDot> doesn't accept that prop. Declared props: color, active, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|key|ref|className|style|children)$/]",
        "message": "<UtilityBar> doesn't accept that prop. Declared props: links."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
